{
  "description": "Once a week, in the first session, tell the user when the anomaly backlog needs them; run measure in the background at session start; deny shell file writes in subagents",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/anomaly.py", "nudge"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/anomaly.py", "measure", "--quiet"],
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/anomaly.py", "check", "subagent-bash"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
